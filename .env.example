# 복사해서 .env 로 쓴다. 세 프로세스(api, worker, db 도구)가 같은 파일을 읽는다.
# KOJ 는 백엔드와 워커가 각자 다른 yaml 을 봐서 Static 경로와 큐 이름이 어긋날 수 있었다.

# ---- 공통 ----
# 호스트에 PostgreSQL 이 이미 깔려 있으면 5432 가 그쪽으로 간다. 그래서 기본을 비켜 둔다
POSTGRES_PORT=55432
DATABASE_URL=postgres://oj:oj@localhost:55432/oj

# 테스트케이스가 사는 곳. api 가 쓰고 worker 가 읽는다. 반드시 같은 실체를 가리켜야 한다
DATA_DIR=./var/data

# ---- api ----
PORT=3000
# 32자 이상. 운영에서 예시값을 그대로 두면 누구나 관리자 토큰을 만들 수 있다
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SEC=604800
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# ---- worker ----
# 리눅스에서만 돈다. isolate 가 cgroup 과 네임스페이스를 직접 다루기 때문이다.
# Windows 개발이면 WSL2 안에서 띄울 것. docs/development.md 참고
WORKER_ID=dev-1
WORKER_CAPACITY=2
WORKER_TC_PARALLEL=2

# isolate 박스 루트. tmpfs 권장. 채점 산출물은 전부 휘발성이다
#   sudo mount -t tmpfs -o size=2g tmpfs ./var/boxes
BOX_ROOT=./var/boxes

RUNNER_IMAGE_PREFIX=ojik-runner
RUNNER_CONTAINER_PREFIX=ojik-runner
RUNNER_REPLICAS=1

# 이 워커가 쓸 isolate 박스 id 시작값. 한 호스트에 워커를 여럿 띄우면 워커마다 달리 줘야 한다.
# 겹치면 샌드박스 uid 가 겹쳐서 제출이 간헐적으로 EAGAIN 으로 죽는다
BOX_ID_BASE=0
# 비워 두면 플랫폼에 맞게 고른다. Windows 는 named pipe, 리눅스는 유닉스 소켓
# DOCKER_SOCKET=/var/run/docker.sock

POLL_INTERVAL_MS=3000
LOG_LEVEL=info

# ---- web ----
# 비워 두면 /api 로 같은 오리진에 붙는다. 개발 서버는 vite 프록시가, 운영은 nginx 가 넘긴다.
# API 가 다른 오리진에 있을 때만 절대 URL 을 적는다 (그때는 CORS_ORIGINS 도 맞춰야 함)
# VITE_API_BASE=https://oj.example.com/api
