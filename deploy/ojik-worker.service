# /etc/systemd/system/ojik-worker.service 로 복사한다.
#
# api 와 달리 이 유닛은 거의 못 조인다. isolate 가 privileged 컨테이너를 띄우고
# cgroup 과 마운트 네임스페이스를 직접 다루기 때문이다. 조이면 채점이 안 된다.

[Unit]
Description=OJIK judge worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# 도커 소켓에 붙어야 한다. docker 그룹에 넣는 것은 사실상 root 를 주는 것과 같다.
# 그래도 root 로 직접 돌리는 것보다는 낫다
User=ojik
Group=ojik
SupplementaryGroups=docker
WorkingDirectory=/srv/ojik
EnvironmentFile=/srv/ojik/.env

ExecStart=/usr/bin/npm start --workspace @ojik/worker

Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

# 채점 중인 제출을 마치고 러너를 정리할 시간을 준다.
# 중간에 끊겨도 lease 가 풀려 다른 워커가 회수하지만, 깨끗이 내려가는 쪽이 낫다
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ojik-worker

[Install]
WantedBy=multi-user.target
