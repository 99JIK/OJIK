# /etc/systemd/system/ojik-api.service 로 복사한다.
#
#   sudo cp deploy/ojik-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ojik-api

[Unit]
Description=OJIK API
# Postgres 가 도커에 있으므로 docker 를 기다린다. Requires 가 아니라 After 인 건
# 도커가 늦게 떠도 api 는 재시작으로 붙기 때문이다. 기동 순서로 묶으면 둘이 같이 죽는다
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ojik
Group=ojik
WorkingDirectory=/srv/ojik

# .env 를 읽는다. loadEnv 도 같은 파일을 보지만, systemd 가 먼저 넣어 두면
# 설정이 틀렸을 때 journalctl 에 바로 보인다
EnvironmentFile=/srv/ojik/.env

ExecStart=/usr/bin/npm start --workspace @ojik/api

Restart=always
RestartSec=3
# 재시작 폭주를 끊는다. 설정이 틀려서 즉시 죽는 경우 로그가 초당 수십 줄로 쌓인다
StartLimitBurst=5
StartLimitIntervalSec=60

# 받던 요청을 마치고 DB 커넥션을 닫을 시간을 준다. index.ts 가 SIGTERM 을 처리한다
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ojik-api

# api 는 샌드박스가 필요 없다. 워커와 달리 조일 수 있는 만큼 조인다
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 테스트케이스와 업로드를 쓴다. 이 경로만 열어 둔다
ReadWritePaths=/srv/ojik/var

[Install]
WantedBy=multi-user.target
